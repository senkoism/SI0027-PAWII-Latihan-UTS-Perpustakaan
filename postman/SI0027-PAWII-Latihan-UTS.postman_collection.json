{
  "info": {
    "name": "SI0027 PAW II - Latihan UTS - Buku Perpustakaan",
    "description": "Koleksi pengujian otomatis Latihan UTS PAW II (RESTful API CRUD Buku Perpustakaan Kampus).\n\nJalankan folder berurutan dari atas ke bawah (Collection Runner atau Newman) dengan environment 'Latihan UTS - Local'. Request saling berantai lewat variabel environment (perpustakaanId, bukuId, ...). Data unik dibuat otomatis pada request 1.1 sehingga collection dapat dijalankan berulang kali.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Perpustakaan",
      "item": [
        {
          "name": "1.1 Buat perpustakaan - sukses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/perpustakaan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "perpustakaan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{perpustakaanNama}}\",\n  \"lokasi\": \"Gedung A Lantai 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data unik per run supaya collection bisa dijalankan berulang kali",
                  "const ts = Date.now();",
                  "pm.environment.set(\"perpustakaanNama\", \"Perpustakaan Latihan \" + ts);",
                  "const base = String(ts).slice(-10).padStart(10, \"0\");",
                  "pm.environment.set(\"isbn1\", \"978\" + base);",
                  "pm.environment.set(\"isbn2\", \"978\" + String((Number(base) + 1) % 10000000000).padStart(10, \"0\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Perpustakaan tersimpan\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"_id\");",
                  "  pm.expect(body.nama).to.eql(pm.environment.get(\"perpustakaanNama\"));",
                  "  pm.environment.set(\"perpustakaanId\", body._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Buat perpustakaan - nama duplikat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/perpustakaan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "perpustakaan"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{perpustakaanNama}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Body memuat properti message\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"message\");",
                  "  pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Daftar perpustakaan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/perpustakaan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "perpustakaan"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Berupa array dan memuat perpustakaan yang baru dibuat\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  const ids = body.map(function (k) { return k._id; });",
                  "  pm.expect(ids).to.include(pm.environment.get(\"perpustakaanId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
