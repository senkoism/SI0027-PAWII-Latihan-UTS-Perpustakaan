              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "buku"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Pemrograman Web dengan Express\",\n  \"isbn\": \"{{isbn1}}\",\n  \"pengarang\": [\n    \"Budi Santoso\",\n    \"Siti Aminah\"\n  ],\n  \"detail\": {\n    \"halaman\": 320,\n    \"edisi\": 2\n  },\n  \"stok\": 5,\n  \"perpustakaanId\": \"{{perpustakaanId}}\",\n  \"tersedia\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Buku tersimpan lengkap (embedded & referencing)\", function () {",
                  "  const m = pm.response.json();",
                  "  pm.expect(m).to.have.property(\"_id\");",
                  "  pm.expect(m.judul).to.eql(\"Pemrograman Web dengan Express\");",
                  "  pm.expect(m.isbn).to.eql(pm.environment.get(\"isbn1\"));",
                  "  pm.expect(m.pengarang).to.eql([\"Budi Santoso\", \"Siti Aminah\"]);",
                  "  pm.expect(m.detail).to.include({ halaman: 320, edisi: 2 });",
                  "  pm.expect(m.perpustakaanId).to.eql(pm.environment.get(\"perpustakaanId\"));",
                  "  pm.expect(m.stok).to.eql(5);",
                  "  pm.expect(m.tersedia).to.eql(true);",
                  "  pm.environment.set(\"bukuId\", m._id);",
                  "});"
                ]
              }
            }
          ]
        },
